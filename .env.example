# Public URL of the app (exposed to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/mediscan

# Secret used to sign JWTs for auth sessions
JWT_SECRET=

# Cloudinary credentials, used to host uploaded profile photos
# Find these on the Cloudinary dashboard: https://console.cloudinary.com/ (Account Details card)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base URL of the external AI Assistant API (wired up later; /api/ai-assistant/ask stubs it for now)
AI_ASSISTANT_API_URL=

# Base URL of the external Documents API (used by POST /api/documents to upload files)
DOCUMENTS_API_BASE_URL=http://127.0.0.1:8000
