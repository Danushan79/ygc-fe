# Public URL of the app (exposed to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/mediscan

# Secret used to sign JWTs for auth sessions
JWT_SECRET=

# Cloudinary credentials, used to host uploaded profile photos
# Find these on the Cloudinary dashboard: https://console.cloudinary.com/ (Account Details card)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base URL of the Python backend (used by POST /api/documents and /api/ai-assistant/ask,
# which are both routes on the same FastAPI service)
DOCUMENTS_API_BASE_URL=http://127.0.0.1:8000

# Google Cloud API key used server-side by /api/doctors/search to power the "Find a
# Doctor" modal. The project this key belongs to must have "Places API (New)" and
# "Geocoding API" enabled. This key is only ever used from server code (never sent to
# the browser), so restrict it to those two APIs and, if your hosting allows it, by IP.
GOOGLE_PLACES_API_KEY=
